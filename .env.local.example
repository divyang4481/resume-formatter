# Copy to .env.local for Docker Compose local integration testing.
# S3, SQS, and Postgres point at local containers; Bedrock LLM calls still use real AWS credentials.

PROJECT_NAME="Agentic Document Platform"

CLOUD_PROVIDER=local
RUNTIME_MODE=local
PROCESSING_MODE=async
QUEUE_PROVIDER=sqs
STORAGE_PROVIDER=s3
KNOWLEDGE_PROVIDER=local
AGENT_PROVIDER=python_orchestrated
LLM_BACKEND=aws_bedrock

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localstack:4566
LOCALSTACK_AWS_ACCESS_KEY_ID=test
LOCALSTACK_AWS_SECRET_ACCESS_KEY=test

S3_BUCKET_INPUT=local-resume-input-bucket
S3_BUCKET_OUTPUT=local-resume-output-bucket
SQS_PROCESSING_QUEUE_URL=http://localstack:4566/000000000000/resume-processing-queue
DATABASE_URL=postgresql+psycopg2://app_user:app_password@postgres:5432/app_db

# Choose one real AWS auth method for Bedrock. Do not use the LocalStack dummy keys for Bedrock.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

BEDROCK_DEFAULT_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
BEDROCK_TEMPLATE_ANALYSIS_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
