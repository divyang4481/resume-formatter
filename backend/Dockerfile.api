# Use the pre-built base image containing all dependencies
ARG BASE_IMAGE=114644266543.dkr.ecr.ap-south-1.amazonaws.com/agentic-doc-base-dev:v1.2.0
FROM ${BASE_IMAGE}

WORKDIR /app

# Install boto3 crt extension for AWS SSO credential resolving
RUN pip install --no-cache-dir "boto3[crt]"

# Copy application code
COPY ./app ./app

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
