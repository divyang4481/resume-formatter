# Use the pre-built base image containing all dependencies
ARG BASE_IMAGE=114644266543.dkr.ecr.ap-south-1.amazonaws.com/agentic-doc-base-dev:v1.2.5
FROM ${BASE_IMAGE}

WORKDIR /app

# Install dependencies not present in base image
RUN pip install --no-cache-dir "boto3[crt]" lxml docxtpl

# Copy application code
COPY ./app ./app

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
