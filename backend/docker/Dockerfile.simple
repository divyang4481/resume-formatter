# Simple single-stage Dockerfile for AWS deployment
FROM --platform=linux/amd64 python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-jre-headless \
    build-essential \
    libpq-dev \
    libxcb1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files first (for better caching)
COPY pyproject.toml ./

# Install PyTorch CPU-only first (lighter, no CUDA)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install core dependencies
RUN pip install --no-cache-dir \
    "fastapi>=0.135.2,<0.136.0" \
    "pydantic>=2.12.5,<3.0.0" \
    "pydantic-settings>=2.13.1,<3.0.0" \
    "uvicorn>=0.42.0,<0.43.0" \
    "langgraph>=1.1.4,<2.0.0" \
    "langchain-core>=1.2.23,<2.0.0" \
    "python-multipart>=0.0.22,<0.0.23" \
    "sqlalchemy>=2.0.48,<3.0.0" \
    "google-generativeai>=0.8.6,<0.9.0" \
    "docxtpl>=0.20.2,<0.21.0" \
    "fastapi-mcp>=0.1.0" \
    "mcp>=1.27.0,<2.0.0" \
    "sse-starlette>=3.3.4,<4.0.0" \
    "python-jose[cryptography]>=3.5.0,<4.0.0" \
    "passlib[bcrypt]>=1.7.4,<2.0.0" \
    "psycopg2-binary>=2.9.9,<3.0.0" \
    "boto3>=1.36.0,<2.0.0" \
    "botocore[crt]>=1.36.0,<2.0.0"

# Install lightweight ML dependencies (CPU-only, no heavy models)
# Note: sentence-transformers removed - using AWS Bedrock Titan Embeddings instead
RUN pip install --no-cache-dir \
    "chromadb>=1.5.5,<2.0.0"

# Install document processing libraries
# torchvision is required by docling's PDF layout/table models - install CPU-only build
RUN pip install --no-cache-dir \
    torchvision --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    "docling>=2.0.0,<3.0.0" \
    "transformers>=4.41.0,<5.0.0"

# Copy application code
COPY ./app /app/app
COPY ./config /app/config
COPY ./templates /app/templates
COPY ./policies /app/policies

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Expose FastAPI port
EXPOSE 8000

# Start the FastAPI server
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
