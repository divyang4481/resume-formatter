# Use the pre-built base image containing all dependencies
ARG BASE_IMAGE=114644266543.dkr.ecr.ap-south-1.amazonaws.com/agentic-doc-base-dev:latest
FROM ${BASE_IMAGE}

WORKDIR /app

# Install boto3 crt extension for AWS SSO credential resolving
RUN pip install --no-cache-dir "boto3[crt]"

# Copy application code
COPY ./app ./app
COPY ./init_db.py ./init_db.py

RUN mkdir -p .data

# Install RapidOCR explicitly to enable model pre-downloading
RUN pip install --no-cache-dir rapidocr-onnxruntime

# Pre-download RapidOCR models so they are ready at runtime
RUN python -c "from rapidocr_onnxruntime import RapidOCR; RapidOCR()"

CMD ["python", "-m", "app.core.worker"]
