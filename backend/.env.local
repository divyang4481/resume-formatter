# Local Development Environment - Connects to AWS Services
# Database: AWS RDS PostgreSQL
# LLM: AWS Bedrock (Llama 3)
# Storage: AWS S3

# ==========================================
# AWS Configuration
# ==========================================
CLOUD=aws
AWS_REGION=ap-south-1

# ==========================================
# Database Configuration (AWS RDS)
# ==========================================
DATABASE_URL=postgresql://dbadmin:DemoPassword123@resume-formatter-demo-db.ctgoo20ag6cj.ap-south-1.rds.amazonaws.com:5432/postgres

# ==========================================
# LLM Configuration (AWS Bedrock)
# ==========================================
LLM_BACKEND=aws_bedrock
LLM_MODEL_NAME=amazon.nova-lite-v1:0

# ==========================================
# Storage Configuration (AWS S3)
# ==========================================
STORAGE_BACKEND=s3
S3_BUCKET=114644266543-resume-formatter-demo-storage

# ==========================================
# Document Parsing (Docling)
# ==========================================
DOCUMENT_PARSER_PRIMARY_PDF=docling
DOCUMENT_PARSER_FALLBACK_PDF=docling
DOCUMENT_PARSER_PRIMARY_DOCX=docling
DOCUMENT_PARSER_FALLBACK_DOCX=docling

# ==========================================
# Vector Search & Template Matching
# ==========================================
VECTOR_SEARCH_ENABLED=true

# ==========================================
# Worker Throughput Controls
# ==========================================
TEMPLATE_SELECTOR_MODE=hybrid

# ==========================================
# Application Settings
# ==========================================
PROJECT_NAME=Resume Formatter API - Local Dev
LOG_LEVEL=DEBUG
ENABLE_AUDIT_LOGGING=true

# ==========================================
# CORS Settings (Allow local Angular frontend)
# ==========================================
CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# ==========================================
# Worker Configuration
# ==========================================
MAX_PARALLEL_JOBS=1
MESSAGE_QUEUE_POLL_INTERVAL=2
MESSAGE_QUEUE_BACKEND=db
MESSAGE_QUEUE_VISIBILITY_TIMEOUT_SECONDS=1800
DOCUMENT_PROCESSING_QUEUE_NAME=document_processing_local
# For AWS SQS backend, set:
# MESSAGE_QUEUE_BACKEND=sqs
# SQS_DOCUMENT_PROCESSING_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
