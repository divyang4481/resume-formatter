@@ -118,6 +118,10 @@
                 # Complex objects like tables are still handled by Phase 1/2 Jinja injection
                 if isinstance(value, str) and value != "N/A":
                     self._replace_in_doc(doc, marker, value)
+                elif isinstance(value, list) and isinstance(value[0], dict) if value else False:
+                    # Format complex objects nicely as strings for replacement if we have a direct marker
+                    formatted_str = self._format_complex_list(value)
+                    self._replace_complex_block(doc, marker, formatted_str)

     def _inject_jinja_markers(
         self, doc, fill_plan: TemplateFillPlan, analysis: TemplateAnalysis
@@ -129,6 +133,10 @@
         # Convert fields to a lookup for quick injection strategy matching
         field_map = {f.fieldname: f for f in analysis.fields}

+        for fieldname, strategy_info in fill_plan.strategies.items():
+            if strategy_info.strategy == "replace_complex_block":
+                # Handled directly or by Jinja
+                pass
         for fieldname, strategy_info in fill_plan.strategies.items():
             marker = strategy_info.marker_text or f"[[{fieldname}]]"

@@ -140,6 +148,8 @@
                 self._fill_cell_after_label(doc, strategy_info.label, tag)
             elif strategy_info.strategy == "replace_section_body" and strategy_info.heading:
                 self._replace_section_content(doc, strategy_info.heading, tag)
+            elif strategy_info.strategy == "replace_complex_block":
