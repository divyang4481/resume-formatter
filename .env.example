PROJECT_NAME="Agentic Document Platform"

# Architecture Config
CLOUD_PROVIDER=local
RUNTIME_MODE=local
PROCESSING_MODE=async
QUEUE_PROVIDER=local
STORAGE_PROVIDER=local
KNOWLEDGE_PROVIDER=local
AGENT_PROVIDER=local_llm

# AWS Specific Config
AWS_REGION=us-east-1
S3_BUCKET_INPUT=agentic-document-input-bucket
S3_BUCKET_OUTPUT=agentic-document-output-bucket
SQS_PROCESSING_QUEUE_URL=
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
BEDROCK_KB_ID=

# Document Parsing Routing & Guard
ENABLE_DOCLING=true
ENABLE_TIKA_FALLBACK=true
ENABLE_GPU_WORKER=false
PARSER_TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=10

# LLM Settings
LLM_BACKEND=aws_bedrock
LLM_MODEL_NAME=meta.llama3-8b-instruct-v1:0
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Storage Settings
LOCAL_STORAGE_PATH=./data

LOG_LEVEL=INFO
