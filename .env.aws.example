# Copy to .env for an AWS-backed deployment/runtime.
# No AWS_ENDPOINT_URL is set here, so S3/SQS/Bedrock use real AWS endpoints.

PROJECT_NAME="Agentic Document Platform"

CLOUD_PROVIDER=aws
RUNTIME_MODE=aws
PROCESSING_MODE=async
QUEUE_PROVIDER=sqs
STORAGE_PROVIDER=s3
KNOWLEDGE_PROVIDER=bedrock_kb
AGENT_PROVIDER=python_orchestrated
LLM_BACKEND=aws_bedrock

AWS_REGION=ap-south-1
S3_BUCKET_INPUT=replace-with-real-input-bucket
S3_BUCKET_OUTPUT=replace-with-real-output-bucket
SQS_PROCESSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/replace-with-real-queue
DATABASE_URL=postgresql+psycopg2://app_user:app_password@replace-rds-endpoint:5432/app_db

# Choose the auth mechanism used by your deployment environment.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

BEDROCK_KB_ID=replace-with-bedrock-kb-id
BEDROCK_DEFAULT_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
BEDROCK_TEMPLATE_ANALYSIS_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
